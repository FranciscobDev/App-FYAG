NODE_ENV=development
PORT=3000

# Opción A: Variables individuales (Local o Supabase Session Pooler en puerto 5432)
DB_HOST=localhost
DB_PORT=5432
DB_USER=fyag_app
DB_PASSWORD=replace-with-a-local-password
DB_DATABASE=fyag_db
# Migraciones al arrancar: déjalo en false si la base se creó con estructura_db.md (ya incluye todo)
APLICAR_MIGRACIONES=false

# TLS a PostgreSQL (si DB_HOST es *.supabase.com se activa automáticamente)
DB_SSL=false

# Opción B (alternativa): pegar directamente el URI del Session Pooler de Supabase (puerto 5432)
# DATABASE_URL=postgresql://postgres.tu_project_ref:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Clave opcional dedicada para cifrado AES-256-GCM en reposo (mínimo 32 caracteres)
DATA_ENCRYPTION_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Obligatorio en producción; en desarrollo se permiten los orígenes localhost habituales de Expo.
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Obligatorio en producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FYAG <no-responder@example.com>

URL_RESTABLECER_CLAVE=http://localhost:8081/restablecer-clave
