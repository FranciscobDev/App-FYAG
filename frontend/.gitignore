# =============================================================================
# FYAG Frontend - .gitignore (Expo & React Native)
# =============================================================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Variables de entorno y secretos (NUNCA permitir .env; solo .env.example)
.env
.env.*
*.env
!.env.example
.npmrc
google-services.json
GoogleService-Info.plist
*credentials*.json
credentials.json
*service-account*.json
*secret*.json
.eas/
.vercel/

# Expo & Bundler
.expo/
.expo-shared/
web-build/
dist/
dist-ssr/
build/
out/
.metro-health-check*

# Carpetas nativas generadas por prebuild
/ios
/android
.kotlin/
*.orig.*

# Claves y certificados de firma
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.cer
*.der
*.crt
*.pfx

# Binarios compilados
*.apk
*.aab
*.ipa
*.app
*.dSYM/

# Caché offline local y archivos temporales
fyag_cache_*.json
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.bak
*.backup
*.tmp
*.temp
*~

# Logs y depuración
logs/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Sistema Operativo y Editores
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
